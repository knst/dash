# syntax=docker/dockerfile:1.3

FROM ubuntu:jammy
LABEL maintainer="Dash Developers <dev@dash.org>"
LABEL description="Dockerised DashCore"

ARG USER_ID
ARG GROUP_ID
ARG TAG
ARG TARGETARCH

ENV HOME /home/dash

# add user with specified (or default) user/group ids
ENV USER_ID ${USER_ID:-1000}
ENV GROUP_ID ${GROUP_ID:-1000}
RUN groupadd -g ${GROUP_ID} dash && \
    useradd -u ${USER_ID} -g dash -s /bin/bash -m -d /home/dash dash  && \
    mkdir /home/dash/.dashcore && \
    chown ${USER_ID}:${GROUP_ID} -R /home/dash

# The release workflow downloads the binaries into release/ in the build context
RUN --mount=type=bind,source=release,target=/release \
    case $TARGETARCH in arm64) arch="aarch64-linux-gnu"; ;; amd64) arch="x86_64-linux-gnu"; ;; *) echo "ERROR: Architecture $TARGETARCH not supported."; exit 1; ;; esac \
      && tar -xvf /release/dashcore-${TAG}-$arch.tar.gz -C /tmp/ \
      && find /tmp/dashcore*/bin -type f ! -name 'dash-qt' -exec cp {} /usr/local/bin \; \
      && rm -rf /tmp/dashcore* \
      && chmod a+x /usr/local/bin/*

USER dash

VOLUME ["/home/dash"]

COPY docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]

EXPOSE 9998 9999 19998 19999

WORKDIR /home/dash
